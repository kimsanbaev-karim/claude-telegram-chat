AI_PAIR_BOT_TOKEN=123456789:AAH-замените-на-токен-от-BotFather
AI_PAIR_CHAT_ID=-1001234567890
AI_PAIR_ALLOWED_USERS=123456789
AI_PAIR_STATE_DIR=~/.claude-telegram-chat

# Распознавание голосовых и аудио: интерпретатор и скрипт, печатающий текст в stdout.
# Подойдёт любой локальный whisper — например, faster-whisper.
AI_PAIR_WHISPER_PYTHON=/path/to/whisper/.venv/Scripts/python.exe
AI_PAIR_WHISPER_SCRIPT=/path/to/whisper/transcribe.py

# Две машины, два бота, общие темы: реестр тем кладётся в синхронизируемый vault,
# чтобы тему, заведённую одной машиной, знала и другая. Без переменной — STATE_DIR/threads.json.
# AI_PAIR_REGISTRY=/путь/к/синхронизируемой/папке/threads.json
# Сообщения агенту отбирает внешний посредник (платформа) и кладёт в STATE_DIR/delivered —
# follow.py читает эту ленту, а не ленту бота. 👀 тогда ставит только follow.py той машины, кому доставлено.
# AI_PAIR_FOLLOW_DIR=delivered
# AI_PAIR_INTAKE_REACTION=0
